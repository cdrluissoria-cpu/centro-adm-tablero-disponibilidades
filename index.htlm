<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Disponibilidad — Congregación Hnas. Dominicas</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Mono:wght@300;400;500&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#fff;--surface:#f7f7f5;--surface2:#efefec;--border:#e0e0d8;--text:#111;--text2:#555550;--text3:#999990;--c1:#a07820;--c2:#1a9a50;--c3:#2060a8;--c4:#7a50a8;--c5:#b03030;}
*{margin:0;padding:0;box-sizing:border-box;}
body{background:var(--bg);color:var(--text);font-family:'DM Sans',sans-serif;min-height:100vh;padding:2rem 2.5rem;}
header{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:1.5rem;padding-bottom:1.1rem;border-bottom:2px solid var(--border);}
.org-tag{font-size:.85rem;text-transform:uppercase;letter-spacing:.12em;color:var(--c1);font-weight:600;margin-bottom:.3rem;}
header h1{font-family:'DM Serif Display',serif;font-size:1.85rem;color:var(--text);letter-spacing:-.02em;line-height:1.1;}
header h1 em{color:var(--c1);font-style:italic;}
.date-badge{font-family:'DM Sans',sans-serif;font-size:.78rem;font-weight:600;color:#fff;background:var(--c1);padding:.45rem 1.2rem;border-radius:100px;letter-spacing:.03em;box-shadow:0 2px 8px rgba(160,120,32,.25);}
.tabs{display:flex;gap:.3rem;margin-bottom:1.5rem;border-bottom:2px solid var(--border);}
.tab-btn{padding:.6rem 1.4rem;font-size:.75rem;font-weight:600;letter-spacing:.04em;color:var(--text2);background:none;border:none;border-bottom:2px solid transparent;margin-bottom:-2px;cursor:pointer;transition:color .15s,border-color .15s;}
.tab-btn:hover{color:var(--text);}
.tab-btn.active{color:var(--c3);border-bottom-color:var(--c3);}
.tab-btn.t-inviu.active{color:#007a35;border-bottom-color:#007a35;}
.tab-btn.t-hist.active{color:#7a3a8a;border-bottom-color:#7a3a8a;}
.tab-btn.t-histtot.active{color:#b03030;border-bottom-color:#b03030;}
.tab-panel{display:none;}.tab-panel.active{display:block;}
.hero{background:linear-gradient(130deg,#12172a 0%,#1a2744 55%,#0d3a6e 100%);border-radius:18px;padding:1.8rem 2.2rem;margin-bottom:1.25rem;display:flex;align-items:center;gap:2rem;overflow:hidden;position:relative;}
.hero::after{content:'';position:absolute;right:-80px;top:-80px;width:260px;height:260px;border-radius:50%;background:rgba(201,168,76,.07);pointer-events:none;}
.hl-label{font-size:.64rem;text-transform:uppercase;letter-spacing:.14em;color:rgba(255,255,255,.42);margin-bottom:.4rem;}
.hl-amount{font-family:'DM Serif Display',serif;font-size:2.8rem;color:#fff;letter-spacing:-.03em;line-height:1;}
.hl-amount span{color:#c9a84c;}
.hl-sub{margin-top:.4rem;font-size:.67rem;color:rgba(255,255,255,.32);font-family:'DM Mono',monospace;}
.hero-pills{display:flex;gap:.8rem;flex-wrap:wrap;margin-left:auto;}
.pill{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);border-radius:12px;padding:.75rem 1.1rem;text-align:center;min-width:120px;}
.pill .p-lbl{font-size:.57rem;text-transform:uppercase;letter-spacing:.1em;color:rgba(255,255,255,.36);margin-bottom:.22rem;}
.pill .p-val{font-family:'DM Mono',monospace;font-size:.95rem;color:#fff;font-weight:500;}
.pill .p-pct{font-size:.59rem;color:#c9a84c;font-family:'DM Mono',monospace;margin-top:.1rem;}
.sum-row{display:grid;grid-template-columns:repeat(5,1fr);gap:.75rem;margin-bottom:1.25rem;}
.sum-row-4{display:grid;grid-template-columns:repeat(4,1fr);gap:.75rem;margin-bottom:1.25rem;}
.sc{background:var(--surface);border:1px solid var(--border);border-radius:13px;padding:1rem 1.1rem;position:relative;overflow:hidden;transition:box-shadow .2s,border-color .2s;}
.sc:hover{box-shadow:0 4px 18px rgba(0,0,0,.07);border-color:var(--sc-c);}
.sc::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--sc-c,#aaa);border-radius:13px 13px 0 0;}
.sc .sc-ico{position:absolute;top:.8rem;right:.85rem;font-size:1.15rem;opacity:.13;}
.sc .sc-lbl{font-size:.59rem;text-transform:uppercase;letter-spacing:.1em;color:var(--text3);margin-bottom:.4rem;}
.sc .sc-val{font-family:'DM Mono',monospace;font-size:1.03rem;font-weight:500;color:var(--text);}
.sc .sc-sub{font-size:.59rem;color:var(--sc-c,var(--text3));margin-top:.3rem;font-family:'DM Mono',monospace;}
.dg{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1rem;}
.dg .full{grid-column:1/-1;}.div2{display:grid;grid-template-columns:1fr 1fr;gap:1rem;}
.inv-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1rem;}
.inv-grid .full{grid-column:1/-1;}
.hist-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1rem;}
.hist-grid .full{grid-column:1/-1;}
.sec{background:var(--surface);border:1px solid var(--border);border-radius:13px;overflow:hidden;}
.sh{padding:.78rem 1.25rem;border-bottom:1px solid var(--border);background:#fff;display:flex;align-items:center;gap:.5rem;}
.sh .dot{width:7px;height:7px;border-radius:50%;background:var(--dc,#aaa);flex-shrink:0;}
.sh h2{font-size:.65rem;text-transform:uppercase;letter-spacing:.12em;color:var(--text2);font-weight:600;}
.sh .st{margin-left:auto;font-family:'DM Mono',monospace;font-size:.75rem;color:var(--text);font-weight:500;}
.rows{padding:.2rem 0;}
.row{display:flex;justify-content:space-between;align-items:center;padding:.56rem 1.25rem;border-bottom:1px solid rgba(0,0,0,.04);transition:background .12s;}
.row:last-child{border-bottom:none;}.row:hover{background:rgba(0,0,0,.015);}
.rn{font-size:.77rem;color:var(--text2);}
.rn strong{display:block;color:var(--text);font-size:.79rem;font-weight:500;}
.rv{font-family:'DM Mono',monospace;font-size:.77rem;color:var(--text);font-weight:500;text-align:right;}
.rv small{display:block;font-size:.59rem;color:var(--text3);font-weight:300;}
.b{display:inline-block;font-size:.54rem;font-family:'DM Mono',monospace;padding:.07rem .38rem;border-radius:3px;margin-left:.3rem;vertical-align:middle;border:1px solid transparent;}
.bg{background:rgba(26,154,80,.1);color:#1a9a50;border-color:rgba(26,154,80,.2);}
.bb{background:rgba(32,96,168,.1);color:#2060a8;border-color:rgba(32,96,168,.2);}
.bo{background:rgba(160,120,32,.1);color:#a07820;border-color:rgba(160,120,32,.2);}
.br{background:rgba(176,48,48,.1);color:#b03030;border-color:rgba(176,48,48,.2);}
.bv{background:rgba(0,122,53,.1);color:#007a35;border-color:rgba(0,122,53,.2);}
.chart-wrap{background:var(--surface);border:1px solid var(--border);border-radius:13px;overflow:hidden;}
.chart-body{padding:1.2rem 1.5rem;display:flex;align-items:center;gap:2.5rem;}
.chart-legend{flex:1;display:flex;flex-direction:column;gap:.52rem;}
.li{display:flex;align-items:center;gap:.5rem;}
.li .ld{width:10px;height:10px;border-radius:50%;flex-shrink:0;}
.li .ln{font-size:.75rem;color:var(--text2);flex:1;}
.li .lv{font-family:'DM Mono',monospace;font-size:.71rem;color:var(--text);font-weight:500;}
.li .lp{font-family:'DM Mono',monospace;font-size:.64rem;color:var(--text3);min-width:3.5rem;text-align:right;}
footer{margin-top:1.5rem;padding-top:1rem;border-top:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;}
footer p{font-size:.62rem;color:var(--text3);font-family:'DM Mono',monospace;}
.inviu-hero{background:linear-gradient(130deg,#003d1a 0%,#005c28 55%,#007a35 100%);border-radius:18px;padding:1.6rem 2rem;margin-bottom:1.25rem;display:flex;align-items:center;gap:2rem;position:relative;overflow:hidden;}
.inviu-hero::after{content:'';position:absolute;right:-60px;top:-60px;width:220px;height:220px;border-radius:50%;background:rgba(255,255,255,.05);pointer-events:none;}
.ih-label{font-size:.62rem;text-transform:uppercase;letter-spacing:.14em;color:rgba(255,255,255,.45);margin-bottom:.35rem;}
.ih-amount{font-family:'DM Serif Display',serif;font-size:2.5rem;color:#fff;letter-spacing:-.03em;line-height:1;}
.ih-amount span{color:#7aff9e;}
.ih-sub{margin-top:.35rem;font-size:.65rem;color:rgba(255,255,255,.35);font-family:'DM Mono',monospace;}
.inviu-pills{display:flex;gap:.75rem;flex-wrap:wrap;margin-left:auto;}
.ipill{background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.15);border-radius:11px;padding:.7rem 1rem;text-align:center;min-width:110px;}
.ipill .ip-lbl{font-size:.56rem;text-transform:uppercase;letter-spacing:.09em;color:rgba(255,255,255,.38);margin-bottom:.2rem;}
.ipill .ip-val{font-family:'DM Mono',monospace;font-size:.9rem;color:#fff;font-weight:500;}
.ipill .ip-sub{font-size:.57rem;color:#7aff9e;font-family:'DM Mono',monospace;margin-top:.08rem;}
.asset-table{width:100%;border-collapse:collapse;}
.asset-table thead tr{background:#fff;}
.asset-table th{font-size:.59rem;text-transform:uppercase;letter-spacing:.1em;color:var(--text3);font-weight:600;padding:.58rem 1rem;text-align:left;border-bottom:2px solid var(--border);white-space:nowrap;}
.asset-table th.right,.asset-table td.right{text-align:right;}
.asset-table td{font-size:.75rem;padding:.52rem 1rem;border-bottom:1px solid rgba(0,0,0,.04);color:var(--text);}
.asset-table tr:last-child td{border-bottom:none;}
.asset-table tr:hover td{background:rgba(0,0,0,.013);}
.asset-table td.mono{font-family:'DM Mono',monospace;font-size:.73rem;}
.asset-table .ticker{font-family:'DM Mono',monospace;font-size:.72rem;font-weight:600;color:var(--c3);}
.asset-table .desc{font-size:.7rem;color:var(--text2);}
.var-pos{color:#1a9a50;font-weight:600;}
.var-neg{color:#b03030;font-weight:600;}
.dist-bar-wrap{padding:1rem 1.25rem;}
.dist-bar-item{margin-bottom:.7rem;}
.dist-bar-item:last-child{margin-bottom:0;}
.dbi-head{display:flex;justify-content:space-between;margin-bottom:.28rem;}
.dbi-name{font-size:.73rem;color:var(--text2);}
.dbi-val{font-family:'DM Mono',monospace;font-size:.71rem;color:var(--text);font-weight:500;}
.dbi-pct{font-family:'DM Mono',monospace;font-size:.65rem;color:var(--text3);}
.dbi-track{height:5px;background:var(--surface2);border-radius:3px;overflow:hidden;}
.dbi-fill{height:100%;border-radius:3px;}
.inv-chart-body{padding:1.2rem 1.5rem;display:flex;align-items:center;gap:2rem;}
.hist-hero-inv{background:linear-gradient(130deg,#1a0a3a 0%,#2d1560 55%,#4a1a8a 100%);border-radius:18px;padding:1.6rem 2rem;margin-bottom:1.25rem;display:flex;align-items:center;gap:2rem;position:relative;overflow:hidden;}
.hist-hero-tot{background:linear-gradient(130deg,#3a0a0a 0%,#601515 55%,#8a1a20 100%);border-radius:18px;padding:1.6rem 2rem;margin-bottom:1.25rem;display:flex;align-items:center;gap:2rem;position:relative;overflow:hidden;}
.hh-label{font-size:.62rem;text-transform:uppercase;letter-spacing:.14em;color:rgba(255,255,255,.45);margin-bottom:.35rem;}
.hh-title{font-family:'DM Serif Display',serif;font-size:1.8rem;color:#fff;letter-spacing:-.02em;line-height:1.1;}
.hh-sub{margin-top:.35rem;font-size:.65rem;color:rgba(255,255,255,.35);font-family:'DM Mono',monospace;}
.xpill{background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.15);border-radius:11px;padding:.7rem 1rem;text-align:center;min-width:110px;}
.xpill .xp-lbl{font-size:.56rem;text-transform:uppercase;letter-spacing:.09em;color:rgba(255,255,255,.38);margin-bottom:.2rem;}
.xpill .xp-val{font-family:'DM Mono',monospace;font-size:.88rem;color:#fff;font-weight:500;}
.xpill .xp-sub{font-size:.57rem;font-family:'DM Mono',monospace;margin-top:.08rem;}
.timeline{padding:1.2rem 1.5rem;}
.tl-item{display:flex;gap:1rem;margin-bottom:1.2rem;}
.tl-item:last-child{margin-bottom:0;}
.tl-dot-wrap{display:flex;flex-direction:column;align-items:center;}
.tl-dot{width:13px;height:13px;border-radius:50%;flex-shrink:0;margin-top:.15rem;}
.tl-line{width:2px;flex:1;background:var(--border);margin-top:4px;min-height:20px;}
.tl-item:last-child .tl-line{display:none;}
.tl-date{font-family:'DM Mono',monospace;font-size:.68rem;color:var(--text3);margin-bottom:.15rem;}
.tl-total{font-family:'DM Serif Display',serif;font-size:1.3rem;color:var(--text);line-height:1;}
.tl-var{font-size:.65rem;font-family:'DM Mono',monospace;margin-top:.1rem;}
.tl-detail{font-size:.68rem;color:var(--text2);margin-top:.2rem;line-height:1.5;}
.evo-chart{padding:1.5rem;}
.evo-bars{display:flex;align-items:flex-end;gap:3rem;height:140px;margin-bottom:.8rem;padding:0 1rem;}
.evo-bar-wrap{flex:1;display:flex;flex-direction:column;align-items:center;gap:.4rem;}
.evo-bar{width:100%;border-radius:6px 6px 0 0;}
.evo-bar-lbl{font-family:'DM Mono',monospace;font-size:.65rem;color:var(--text3);}
.evo-bar-val{font-family:'DM Mono',monospace;font-size:.68rem;font-weight:500;}
.comp-table{width:100%;border-collapse:collapse;}
.comp-table thead tr{background:#fff;}
.comp-table th{font-size:.6rem;text-transform:uppercase;letter-spacing:.1em;color:var(--text3);font-weight:600;padding:.6rem 1rem;border-bottom:2px solid var(--border);text-align:left;}
.comp-table th.right,.comp-table td.right{text-align:right;}
.comp-table td{font-size:.76rem;padding:.55rem 1rem;border-bottom:1px solid rgba(0,0,0,.04);color:var(--text);}
.comp-table tr:last-child td{border-bottom:none;}
.comp-table tr:hover td{background:rgba(0,0,0,.013);}
.comp-table td.mono{font-family:'DM Mono',monospace;font-size:.74rem;}
.comp-table .ticker{font-family:'DM Mono',monospace;font-size:.73rem;font-weight:600;color:var(--c3);}
.col-new{color:var(--text);font-family:'DM Mono',monospace;font-size:.74rem;}
.col-old{color:var(--text3);font-family:'DM Mono',monospace;font-size:.72rem;}
@media(max-width:900px){
  .sum-row,.sum-row-4,.inv-grid,.dg,.hist-grid{grid-template-columns:1fr}
  .dg .full,.inv-grid .full,.hist-grid .full{grid-column:1}
  .div2{grid-template-columns:1fr}
  .hero-pills,.inviu-pills,.xpill-wrap{display:none}
  body{padding:1rem}
}
</style>
</head>
<body>
<header>
  <div>
    <div class="org-tag">Congregación Hnas. Dominicas — Centro Administrativo</div>
    <h1>Disponibilidad <em>Financiera</em></h1>
  </div>
  <div class="date-badge">Martes 11 de Marzo 2026</div>
</header>

<div class="tabs">
  <button class="tab-btn active"    onclick="switchTab('general',this)">🏦 Resumen General</button>
  <button class="tab-btn t-inviu"   onclick="switchTab('inviu',this)">📊 Análisis Inviu</button>
  <button class="tab-btn t-hist"    onclick="switchTab('hist',this)">📈 Seguimiento Inviu</button>
  <button class="tab-btn t-histtot" onclick="switchTab('histtot',this)">📊 Seguimiento Total</button>
</div>

<!-- ══════════════════════════════════════ TAB GENERAL ══ -->
<div id="tab-general" class="tab-panel active">
  <div class="hero">
    <div>
      <div class="hl-label">Total General Disponible — ARS equivalente</div>
      <div class="hl-amount"><span>$</span> 608.959.435,16</div>
      <div class="hl-sub">Bancos · Inversiones · Dólares · Euros · Caja efectivo · 11/03/2026</div>
    </div>
    <div class="hero-pills">
      <div class="pill"><div class="p-lbl">USD físicos</div><div class="p-val">15.785,87</div><div class="p-pct">≈ $22.337.006 @ $1.415</div></div>
      <div class="pill"><div class="p-lbl">EUR</div><div class="p-val">764,17</div><div class="p-pct">≈ $1.268.522 @ $1.660</div></div>
      <div class="pill"><div class="p-lbl">Inversiones</div><div class="p-val">$550.942.691</div><div class="p-pct">91,53 % del total</div></div>
      <div class="pill"><div class="p-lbl">Bancos + Caja</div><div class="p-val">$34.411.216</div><div class="p-pct">4,55 % del total</div></div>
    </div>
  </div>
  <div class="sum-row">
    <div class="sc" style="--sc-c:#a07820;"><div class="sc-ico">🏦</div><div class="sc-lbl">Bancos — Pesos</div><div class="sc-val">$33.470.096</div><div class="sc-sub">6 entidades · 5,50 %</div></div>
    <div class="sc" style="--sc-c:#1a9a50;"><div class="sc-ico">💵</div><div class="sc-lbl">Dólares físicos</div><div class="sc-val">USD 15.785,87</div><div class="sc-sub">≈ $22.337.006 · 3,71 %</div></div>
    <div class="sc" style="--sc-c:#7a50a8;"><div class="sc-ico">💶</div><div class="sc-lbl">Euros</div><div class="sc-val">EUR 764,17</div><div class="sc-sub">≈ $1.268.522 · 0,21 %</div></div>
    <div class="sc" style="--sc-c:#2060a8;"><div class="sc-ico">📈</div><div class="sc-lbl">Invertido (Inviu + Fima)</div><div class="sc-val">$550.942.691</div><div class="sc-sub">91,53 % del total</div></div>
    <div class="sc" style="--sc-c:#b03030;"><div class="sc-ico">💰</div><div class="sc-lbl">Caja Efectivo</div><div class="sc-val">$941.120</div><div class="sc-sub">Efectivo pesos · 0,16 %</div></div>
  </div>
  <div class="dg">
    <div class="sec">
      <div class="sh" style="--dc:#a07820;"><div class="dot"></div><h2>Cuentas Bancarias — Pesos</h2><div class="st">$33.470.095,67</div></div>
      <div class="rows">
        <div class="row"><div class="rn"><strong>Banco Galicia</strong>CC N° 0000753-7 357-2</div><div class="rv">$18.762.160,00<small>71,0 %</small></div></div>
        <div class="row"><div class="rn"><strong>Santander</strong>N° 230-000017/8</div><div class="rv">$3.328.919,61<small>12,6 %</small></div></div>
        <div class="row"><div class="rn"><strong>Banco Nación (Rita)</strong>CA N° 17512551359433</div><div class="rv">$2.837.086,75<small>10,7 %</small></div></div>
        <div class="row"><div class="rn"><strong>Supervielle</strong>CC ARS 065-4117380-1</div><div class="rv">$1.068.590,91<small>4,0 %</small></div></div>
        <div class="row"><div class="rn"><strong>Banco Francés (BBVA)</strong>Cuenta corriente</div><div class="rv">$7.452.442,02<small>22,3 %</small></div></div>
        <div class="row"><div class="rn"><strong>Macro</strong>Saldo a girar</div><div class="rv">$20.896,38<small>0,1 %</small></div></div>
      </div>
    </div>
    <div class="sec">
      <div class="sh" style="--dc:#2060a8;"><div class="dot"></div><h2>Inversiones</h2><div class="st">$550.942.691,24</div></div>
      <div class="rows">
        <div class="row"><div class="rn"><strong>Inviu</strong><span class="b bv">Portfolio</span></div><div class="rv">$541.317.868,75<small>98,3 % de inversiones</small></div></div>
        <div class="row"><div class="rn"><strong>Galicia — Fima Premium</strong><span class="b bb">FCI</span></div><div class="rv">$9.624.822,49<small>Cta comitente N° 6061237</small></div></div>
      </div>
      <div style="padding:.65rem 1.25rem .85rem;border-top:1px solid var(--border);">
        <div style="display:flex;justify-content:space-between;font-size:.59rem;color:var(--text3);font-family:'DM Mono',monospace;margin-bottom:.28rem;"><span>■ Inviu 98,3 %</span><span>■ Fima 1,7 %</span></div>
        <div style="height:5px;border-radius:3px;overflow:hidden;display:flex;gap:2px;">
          <div style="flex:98.3;background:#2060a8;border-radius:3px 0 0 3px;"></div>
          <div style="flex:1.7;background:#a07820;border-radius:0 3px 3px 0;"></div>
        </div>
      </div>
      <div class="sh" style="--dc:#b03030;border-top:1px solid var(--border);"><div class="dot"></div><h2>Caja Efectivo</h2><div class="st">$941.120,00</div></div>
      <div class="rows"><div class="row"><div class="rn"><strong>Saldo en caja</strong>Efectivo pesos físico</div><div class="rv">$941.120,00<small>ARS</small></div></div></div>
    </div>
    <div class="full div2">
      <div class="sec">
        <div class="sh" style="--dc:#1a9a50;"><div class="dot"></div><h2>Dólares Físicos</h2><div class="st">USD 15.785,87</div></div>
        <div class="rows">
          <div class="row"><div class="rn"><strong>Economato</strong><span class="b bg">USD</span></div><div class="rv">14.017,00<small>≈ $19.834.055 @ $1.415</small></div></div>
          <div class="row"><div class="rn"><strong>Casa Madre</strong><span class="b bg">USD</span></div><div class="rv">1.300,00<small>≈ $1.839.500 @ $1.415</small></div></div>
          <div class="row"><div class="rn"><strong>Com SSM Rosario</strong><span class="b bg">USD</span></div><div class="rv">90,00<small>≈ $127.350 @ $1.415</small></div></div>
