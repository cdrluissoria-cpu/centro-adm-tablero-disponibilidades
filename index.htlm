          <div style="display:flex;align-items:center;gap:.5rem;"><div style="width:9px;height:9px;border-radius:50%;background:#1a9a50;flex-shrink:0;"></div><span style="font-size:.76rem;color:var(--text);font-weight:500;">Dólares físicos</span></div>
          <div style="display:flex;flex-direction:column;gap:3px;">
            <div style="display:flex;align-items:center;gap:.4rem;">
              <div style="height:8px;border-radius:3px;background:#b0b8c8;opacity:.6;width:calc(3.81% * 0.95);min-width:4px;"></div>
              <span style="font-size:.6rem;font-family:'DM Mono',monospace;color:var(--text3);white-space:nowrap;">3,81 %</span>
            </div>
            <div style="display:flex;align-items:center;gap:.4rem;">
              <div style="height:8px;border-radius:3px;background:#1a9a50;width:calc(3.71% * 0.95);min-width:4px;"></div>
              <span style="font-size:.6rem;font-family:'DM Mono',monospace;color:#1a9a50;font-weight:600;white-space:nowrap;">3,71 %</span>
            </div>
          </div>
          <div style="font-family:'DM Mono',monospace;font-size:.7rem;color:var(--text3);text-align:right;">$22,7M</div>
          <div style="font-family:'DM Mono',monospace;font-size:.7rem;color:var(--text);font-weight:500;text-align:right;">$22,3M</div>
          <div style="font-family:'DM Mono',monospace;font-size:.7rem;color:#b03030;font-weight:600;text-align:right;">-1,39 %</div>
        </div>

        <!-- Fila: Euros -->
        <div style="display:grid;grid-template-columns:180px 1fr 70px 70px 70px;gap:.5rem 1rem;align-items:center;padding:.55rem 0;border-bottom:1px solid rgba(0,0,0,.05);">
          <div style="display:flex;align-items:center;gap:.5rem;"><div style="width:9px;height:9px;border-radius:50%;background:#7a50a8;flex-shrink:0;"></div><span style="font-size:.76rem;color:var(--text);font-weight:500;">Euros</span></div>
          <div style="display:flex;flex-direction:column;gap:3px;">
            <div style="display:flex;align-items:center;gap:.4rem;">
              <div style="height:8px;border-radius:3px;background:#b0b8c8;opacity:.6;width:calc(0.22% * 0.95);min-width:3px;"></div>
              <span style="font-size:.6rem;font-family:'DM Mono',monospace;color:var(--text3);white-space:nowrap;">0,22 %</span>
            </div>
            <div style="display:flex;align-items:center;gap:.4rem;">
              <div style="height:8px;border-radius:3px;background:#7a50a8;width:calc(0.21% * 0.95);min-width:3px;"></div>
              <span style="font-size:.6rem;font-family:'DM Mono',monospace;color:#7a50a8;font-weight:600;white-space:nowrap;">0,21 %</span>
            </div>
          </div>
          <div style="font-family:'DM Mono',monospace;font-size:.7rem;color:var(--text3);text-align:right;">$1,3M</div>
          <div style="font-family:'DM Mono',monospace;font-size:.7rem;color:var(--text);font-weight:500;text-align:right;">$1,3M</div>
          <div style="font-family:'DM Mono',monospace;font-size:.7rem;color:#b03030;font-weight:600;text-align:right;">-1,77 %</div>
        </div>

        <!-- Fila: Caja -->
        <div style="display:grid;grid-template-columns:180px 1fr 70px 70px 70px;gap:.5rem 1rem;align-items:center;padding:.55rem 0;">
          <div style="display:flex;align-items:center;gap:.5rem;"><div style="width:9px;height:9px;border-radius:50%;background:#b03030;flex-shrink:0;"></div><span style="font-size:.76rem;color:var(--text);font-weight:500;">Caja Efectivo</span></div>
          <div style="display:flex;flex-direction:column;gap:3px;">
            <div style="display:flex;align-items:center;gap:.4rem;">
              <div style="height:8px;border-radius:3px;background:#b0b8c8;opacity:.6;width:calc(0.19% * 0.95);min-width:3px;"></div>
              <span style="font-size:.6rem;font-family:'DM Mono',monospace;color:var(--text3);white-space:nowrap;">0,19 %</span>
            </div>
            <div style="display:flex;align-items:center;gap:.4rem;">
              <div style="height:8px;border-radius:3px;background:#b03030;width:calc(0.16% * 0.95);min-width:3px;"></div>
              <span style="font-size:.6rem;font-family:'DM Mono',monospace;color:#b03030;font-weight:600;white-space:nowrap;">0,16 %</span>
            </div>
          </div>
          <div style="font-family:'DM Mono',monospace;font-size:.7rem;color:var(--text3);text-align:right;">$1,1M</div>
          <div style="font-family:'DM Mono',monospace;font-size:.7rem;color:var(--text);font-weight:500;text-align:right;">$0,9M</div>
          <div style="font-family:'DM Mono',monospace;font-size:.7rem;color:#b03030;font-weight:600;text-align:right;">-17,3 %</div>
        </div>

        <!-- Fila total -->
        <div style="display:grid;grid-template-columns:180px 1fr 70px 70px 70px;gap:.5rem 1rem;align-items:center;padding:.65rem 0 0;border-top:2px solid var(--border);margin-top:.4rem;">
          <div style="font-size:.77rem;font-weight:700;color:var(--text);">TOTAL GENERAL</div>
          <div></div>
          <div style="font-family:'DM Mono',monospace;font-size:.72rem;color:var(--text3);font-weight:600;text-align:right;">$594,5M</div>
          <div style="font-family:'DM Mono',monospace;font-size:.72rem;color:var(--text);font-weight:700;text-align:right;">$609,0M</div>
          <div style="font-family:'DM Mono',monospace;font-size:.72rem;color:#1a9a50;font-weight:700;text-align:right;">+2,43 %</div>
        </div>

      </div>
    </div>
  </div>
</div>

<footer>
  <p>Congregación Hnas. Dominicas — Centro Administrativo · Actualizado 11/03/2026 (tarde)</p>
  <p>BNA: USD $1.415 · EUR $1.660 · Inviu TC MEP $1.422,12 · TC CCL $1.462,51</p>
</footer>

<script>
function switchTab(id,btn){
  document.querySelectorAll('.tab-panel').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));
  document.getElementById('tab-'+id).classList.add('active');
  btn.classList.add('active');
  if(id==='inviu') drawPie2();
  if(id==='histtot'){}
}
function drawDonut(id,slices,lbl,sub){
  const c=document.getElementById(id);if(!c)return;
  const ctx=c.getContext('2d');
  const W=c.width,cx=W/2,cy=W/2,oR=W/2-4,iR=W/2-22;
  const tot=slices.reduce((a,s)=>a+s.v,0);
  let a=-Math.PI/2;
  slices.forEach(s=>{
    const sw=(s.v/tot)*Math.PI*2,g=.025;
    ctx.beginPath();ctx.arc(cx,cy,oR,a+g,a+sw-g);ctx.arc(cx,cy,iR,a+sw-g,a+g,true);
    ctx.closePath();ctx.fillStyle=s.c;ctx.fill();a+=sw;
  });
  ctx.textAlign='center';ctx.textBaseline='middle';
  ctx.fillStyle='#111';ctx.font=`bold ${W>180?11:9}px DM Sans,sans-serif`;ctx.fillText(lbl,cx,cy-8);
  ctx.fillStyle='#777';ctx.font=`${W>180?9:8}px DM Mono,monospace`;ctx.fillText(sub,cx,cy+8);
}
drawDonut('pie',[
  {v:550942691,c:'#2060a8'},{v:26417141,c:'#a07820'},
  {v:22337006,c:'#1a9a50'},{v:1268522,c:'#7a50a8'},{v:941120,c:'#b03030'}
],'TOTAL','$609,0M');
let p2=false;
function drawPie2(){if(p2)return;p2=true;
  drawDonut('pie2',[
    {v:159236757,c:'#e07820'},{v:136960092,c:'#2060a8'},{v:96487271,c:'#1a4a9a'},
    {v:72233832,c:'#4888cc'},{v:37387118,c:'#1a9a50'},{v:25187844,c:'#7aacee'},{v:13825955,c:'#7a50a8'}
  ],'INVIU','$541,3M');
}
let p34=false;
function drawPie3(){if(p34)return;p34=true;
  drawDonut('pie3',[
    {v:561854646,c:'#2060a8'},{v:7556648,c:'#a07820'},
    {v:22652949,c:'#1a9a50'},{v:1291447,c:'#7a50a8'},{v:1137620,c:'#b03030'}
  ],'06/03','$594M');
}
function drawPie4(){
  drawDonut('pie4',[
    {v:550942691,c:'#2060a8'},{v:26417141,c:'#a07820'},
    {v:22337006,c:'#1a9a50'},{v:1268522,c:'#7a50a8'},{v:941120,c:'#b03030'}
  ],'11/03','$602M');
}
</script>
</body>
</html>
